{
  "id": "scan_and_act",
  "name": "Scan and Act",
  "description": "Collect a list of items with a user function, then run another function for each item (e.g. pick each target).",
  "version": "1.0.0",
  "imports": [],
  "context": [
    {
      "name": "robot",
      "type": "Robot",
      "blockly": "robot_var",
      "required": true
    }
  ],
  "steps": [
    {
      "id": "collect",
      "label": "Collect items",
      "pattern": "single",
      "inputs": [],
      "output": { "name": "items", "type": "List" },
      "slot": {
        "required": true,
        "signature": {
          "params": [],
          "returns": "List"
        },
        "placeholderLabel": "Choose collect function…"
      }
    },
    {
      "id": "act",
      "label": "For each item → act",
      "pattern": "list_iter",
      "iterOver": "items",
      "itemName": "item",
      "inputs": [
        { "name": "robot", "from": "context.robot" },
        { "name": "item", "from": "iter.item" }
      ],
      "output": null,
      "slot": {
        "required": true,
        "signature": {
          "params": [
            { "name": "robot", "type": "Robot" },
            { "name": "item", "type": "Any" }
          ],
          "returns": "void"
        },
        "placeholderLabel": "Choose act function…"
      }
    }
  ]
}
